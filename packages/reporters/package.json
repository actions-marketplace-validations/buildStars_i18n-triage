{
  "name": "@i18n-triage/reporters",
  "version": "0.1.0",
  "description": "Report formatters for i18n-triage: text / json / sarif / html.",
  "license": "MIT",
  "author": "neo",
  "keywords": [
    "i18n",
    "vue",
    "typescript",
    "ast",
    "hardcoded-strings",
    "chinese",
    "localization",
    "sarif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildStars/i18n-triage.git",
    "directory": "packages/reporters"
  },
  "homepage": "https://github.com/buildStars/i18n-triage#readme",
  "bugs": {
    "url": "https://github.com/buildStars/i18n-triage/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@i18n-triage/core": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@i18n-triage/tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
