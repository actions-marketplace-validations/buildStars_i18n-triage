{
  "name": "@i18n-triage/core",
  "version": "0.1.0",
  "description": "Parse + classify engine for i18n-triage. Pure functions, zero IO.",
  "license": "MIT",
  "author": "neo",
  "keywords": [
    "i18n",
    "vue",
    "typescript",
    "ast",
    "hardcoded-strings",
    "chinese",
    "localization",
    "sarif"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.42",
    "@vue/compiler-sfc": "^3.5.42",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@i18n-triage/tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
