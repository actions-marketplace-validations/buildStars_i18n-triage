{
  "name": "@i18n-triage/core",
  "version": "0.0.0",
  "description": "Parse + classify engine for i18n-triage. Pure functions, zero IO.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@i18n-triage/tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
