{
  "name": "@i18n-triage/cli",
  "version": "0.0.0",
  "description": "Command-line entry for i18n-triage. All file IO lives here.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "i18n-triage": "./dist/index.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@i18n-triage/core": "workspace:*",
    "@i18n-triage/reporters": "workspace:*"
  },
  "devDependencies": {
    "@i18n-triage/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
