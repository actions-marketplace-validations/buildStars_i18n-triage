{
  "name": "@i18n-triage/cli",
  "version": "0.1.0",
  "description": "Command-line entry for i18n-triage. All file IO lives here.",
  "license": "MIT",
  "author": "neo",
  "keywords": [
    "i18n",
    "vue",
    "typescript",
    "ast",
    "hardcoded-strings",
    "chinese",
    "localization",
    "sarif"
  ],
  "type": "module",
  "bin": {
    "i18n-triage": "./dist/bin.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/bin.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.42",
    "@vue/compiler-sfc": "^3.5.42",
    "cac": "^7.0.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@i18n-triage/core": "workspace:*",
    "@i18n-triage/reporters": "workspace:*",
    "@i18n-triage/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
