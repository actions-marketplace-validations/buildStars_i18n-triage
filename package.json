{
  "name": "i18n-triage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "triage": "tsx packages/cli/src/bin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm build && pnpm --filter i18n-triage publish --access public",
    "release:dry": "pnpm build && pnpm --filter i18n-triage publish --access public --dry-run --no-git-checks",
    "release:libs": "pnpm build && pnpm --filter @i18n-triage/core --filter @i18n-triage/reporters publish --access public"
  },
  "devDependencies": {
    "@i18n-triage/eslint-config": "workspace:*",
    "@i18n-triage/tsconfig": "workspace:*",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3"
  }
}
